amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"

local non_security_excludes =
  List(
    "home/.config/hammerspoon/Spoons/EmmyLua.spoon/annotations/**",
    "home/.config/hammerspoon/Spoons/EmmyLua.spoon/docs.json",
    "home/.config/yazi/flavors/**",
    "home/.config/yazi/plugins/**",
    "home/.config/nvim/lua/config/logos.lua",
  )

local checks = new Mapping<String, Step> {
  ["check_added_large_files"] = (Builtins.check_added_large_files) {
    exclude = non_security_excludes
  }
  // ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = (Builtins.check_executables_have_shebangs) {
    exclude = non_security_excludes
  }
  ["check_merge_conflict"] = (Builtins.check_merge_conflict) {
    exclude = non_security_excludes
  }
  ["check_symlinks"] = (Builtins.check_symlinks) {
    exclude = non_security_excludes
  }
  ["detect_private_key"] = Builtins.detect_private_key
  ["git_config_policy"] = new Step {
    check = "bun scripts/check-git-config.ts"
  }
  ["mixed_line_ending"] = (Builtins.mixed_line_ending) {
    exclude = non_security_excludes
  }
  ["newlines"] = (Builtins.newlines) {
    exclude = non_security_excludes
  }
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
    exclude = non_security_excludes
  }
  ["prettier"] = (Builtins.prettier) {
    batch = true
    exclude = non_security_excludes + List("**/*.md")
  }
}

local linters = new Mapping<String, Step> {
  ["actionlint"] = (Builtins.actionlint) {
    exclude = non_security_excludes
  } // GitHub Actions

  ["hadolint"] = (Builtins.hadolint) {
    exclude = non_security_excludes
  } // Dockerfile

  ["rumdl"] = (Builtins.rumdl) {
    batch = true
    exclude = non_security_excludes
  }

  ["lint_skill_index"] = new Step {
    check = "mise run lint-skill-index"
  }

  ["lint_home_skill_index"] = new Step {
    check = "mise run lint-skill-index --base-path home"
  }

  ["validate_skill_evals"] = new Step {
    check = "mise run ai:skills:evals:validate --skills-path home/.agents/skills"
  }

  ["validate_skill_name_conflicts"] = new Step {
    check = "mise run ai:skills:validate-conflicts"
  }

  ["validate_task_name_conflicts"] = new Step {
    check = "mise run mise:tasks:validate-conflicts"
  }

  ["betterleaks"] = (Builtins.betterleaks) {
    batch = true
    prefix = List("mise", "x", "--")
  }

  ["shellcheck"] = (Builtins.shellcheck) {
    exclude = non_security_excludes
  }

  ["sort_package_json"] = (Builtins.sort_package_json) {
    prefix = List("bunx")
    exclude = non_security_excludes
  }

  ["stylua"] = (Builtins.stylua) {
    exclude = non_security_excludes
  }

  ["yamllint"] = (Builtins.yamllint) {
    exclude = non_security_excludes
  }
}

local all = new Mapping<String, Step | Group> {
  ["pre-lint"] = new Group {
    steps = checks
  }

  ["lint"] = new Group {
    steps = linters
  }
}

hooks {
  // "check" and "fix" are special steps for `hk check` and `hk fix` commands
  ["check"] {
    steps = all
  }

  ["fix"] {
    fix = true
    steps = all
  }

  ["commit-msg"] {
    steps {
      ["commitlint"] {
        prefix = "bunx"
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }

  ["pre-commit"] {
    fix = true // automatically modify files with available linter fixes
    stash = "git" // stashes unstaged changes while running fix steps
    steps = all
  }
}
